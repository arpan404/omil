<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct-distribution Mac build: no App Sandbox, so global hotkeys and
	     Accessibility-based insertion work. No special entitlements required. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- App-managed inference sidecars (whisper.cpp/llama.cpp bottles) carry
	     third-party signatures: allow them + their dylibs to load. Required
	     for Release (hardened runtime); harmless for ad-hoc dev builds. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
