---
import Cleanup from "../components/Cleanup.astro";
import Devices from "../components/Devices.astro";
import Dock from "../components/Dock.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Personal from "../components/Personal.astro";
import Private from "../components/Private.astro";
import Schema from "../components/Schema.astro";
import Story from "../components/Story.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Schema slot="head" />
  <Nav />
  <main>
    <!-- The opening and the story share the dock, which stays at the bottom of the window through both.
         The wrapper is its own stacking context so the dock's rings can sit behind the text. -->
    <div class="relative isolate">
      <Hero />
      <Story />
      <Dock />
    </div>
    <Cleanup />
    <Personal />
    <Private />
    <Devices />
    <Faq />
  </main>
  <Footer />
</Layout>
