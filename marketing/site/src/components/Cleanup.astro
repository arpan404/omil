---
import { Icon } from "astro-icon/components";
import { attaches, CLEAN_TEXT, diffTokens, RAW_TEXT } from "../data/site";

// The same diff the app's Changes tab draws (TranscriptDiff + GitDiffView), built at compile time.
const tokens = diffTokens(RAW_TEXT, CLEAN_TEXT);
type Run = { text: string; marked: boolean };
/** Joins tokens into runs of marked and unmarked text. Spaces stay outside the highlight. */
const runs = (list: typeof tokens, mark: "added" | "removed"): Run[] => {
  const out: Run[] = [];
  list.forEach((t, i) => {
    const space = i > 0 && !attaches(t.text) ? " " : "";
    const marked = t.kind === mark;
    const last = out[out.length - 1];
    if (last && last.marked === marked) {
      last.text += space + t.text;
      return;
    }
    if (space) {
      if (last && !last.marked) last.text += space;
      else out.push({ text: space, marked: false });
    }
    out.push({ text: t.text, marked });
  });
  return out;
};
const original = runs(tokens.filter((t) => t.kind !== "added"), "removed");
const cleaned = runs(tokens.filter((t) => t.kind !== "removed"), "added");
/** Marked runs are numbered so their highlights can paint in reading order. */
const numbered = (list: Run[]) => {
  let n = 0;
  return list.map((r) => ({ ...r, n: r.marked ? n++ : -1 }));
};
const tabs = ["Clean", "Original", "Changes"] as const;
const modes = [
  { title: "Clean", body: "Drops the filler, follows your corrections and fixes grammar. The default." },
  { title: "Verbatim", body: "Keeps every word, for quotes, names and code. Switch any time." },
];
---

<section id="cleanup" class="section">
  <div class="shell grid items-center gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-20">
    <div class="lg:order-2">
      <h2 data-reveal class="title">It writes what you meant.</h2>
      <p data-reveal style="--i: 1" class="lead mt-5 max-w-[36ch]">
        Say it the way it comes out. Omil keeps the sentence you were reaching for, and the Changes view shows exactly what it did.
      </p>
      <dl data-reveal style="--i: 2" class="mt-10 grid gap-6 border-t border-line pt-7 sm:grid-cols-2 lg:mt-12">
        {
          modes.map((m) => (
            <div>
              <dt class="font-semibold tracking-[-0.015em]">{m.title}</dt>
              <dd class="mt-1.5 text-[15px] leading-relaxed text-muted">{m.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- The app's Last Transcript card, with its three views. -->
    <div data-reveal="scale" style="--i: 1" class="card rounded-[1.75rem] p-2" data-transcript-card>
      <div class="flex items-center justify-between gap-4 py-2 pr-2 pl-4 max-[26rem]:pl-2 md:pl-5">
        <span class="text-[15px] font-semibold tracking-[-0.015em] whitespace-nowrap max-[26rem]:sr-only">Last transcript</span>
        <div role="tablist" aria-label="Transcript version" class="tabs relative flex rounded-full bg-tile p-[3px] ring-1 ring-line max-[26rem]:flex-1">
          <span class="thumb pointer-events-none absolute top-[3px] bottom-[3px] left-0 rounded-full bg-surface shadow-[0_1px_2px_rgb(var(--shadow-tint)/0.14),0_0_0_1px_var(--line)]" aria-hidden="true"></span>
          {
            tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t}`}
                aria-controls={`panel-${t}`}
                aria-selected={i === 2 ? "true" : "false"}
                tabindex={i === 2 ? 0 : -1}
                class="relative rounded-full px-3 py-1.5 text-[13px] font-medium text-muted transition-colors duration-300 hover:text-ink aria-selected:text-ink max-[26rem]:flex-1 sm:px-3.5"
              >
                {t}
              </button>
            ))
          }
        </div>
      </div>

      <div class="panels mt-1 grid min-h-[12.5rem] items-center rounded-[1.25rem] bg-tile p-3 md:min-h-[13.5rem] md:p-4">
        <p role="tabpanel" id="panel-Clean" aria-labelledby="tab-Clean" hidden class="panel px-3 text-[1.375rem] leading-snug font-medium tracking-[-0.022em] text-balance md:px-4 md:text-[1.75rem]">
          {CLEAN_TEXT}
        </p>
        <p role="tabpanel" id="panel-Original" aria-labelledby="tab-Original" hidden class="panel px-3 text-[1.375rem] leading-snug font-medium tracking-[-0.022em] text-balance text-muted md:px-4 md:text-[1.75rem]">
          {RAW_TEXT}
        </p>
        <div role="tabpanel" id="panel-Changes" aria-labelledby="tab-Changes" class="panel diff space-y-2 font-mono text-[13.5px] leading-[1.75] md:text-[15px]">
          <p class="flex gap-3.5 rounded-[0.875rem] bg-rec/[0.07] px-4 py-3.5 md:px-5 md:py-4" aria-label={`Original: ${RAW_TEXT}`}>
            <span class="text-rec select-none" aria-hidden="true">-</span>
            <span aria-hidden="true">
              {numbered(original).map((r) => (r.marked ? <span class="mark mark-rec" style={`--n: ${r.n}`}>{r.text}</span> : <span>{r.text}</span>))}
            </span>
          </p>
          <p class="flex gap-3.5 rounded-[0.875rem] bg-add/[0.08] px-4 py-3.5 md:px-5 md:py-4" aria-label={`Cleaned: ${CLEAN_TEXT}`}>
            <span class="text-add select-none" aria-hidden="true">+</span>
            <span aria-hidden="true">
              {numbered(cleaned).map((r) => (r.marked ? <span class="mark mark-add" style={`--n: ${r.n}`}>{r.text}</span> : <span>{r.text}</span>))}
            </span>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 px-4 pt-3 pb-2 text-[13px] text-muted md:px-5">
        <Icon name="ph:check-circle-fill" class="size-4 text-add" aria-hidden="true" />
        Inserted into focused field
      </div>
    </div>
  </div>
</section>

<script>
  import { reduceMotion } from "../scripts/motion";

  for (const root of document.querySelectorAll<HTMLElement>("[data-transcript-card]")) {
    const list = root.querySelector<HTMLElement>(".tabs")!;
    const thumb = list.querySelector<HTMLElement>(".thumb")!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const place = (tab: HTMLButtonElement) => {
      thumb.style.width = `${tab.offsetWidth}px`;
      thumb.style.transform = `translateX(${tab.offsetLeft}px)`;
    };
    const select = (tab: HTMLButtonElement) => {
      place(tab);
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!;
        if (on && panel.hidden) {
          panel.hidden = false;
          if (!reduceMotion()) panel.animate([{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 500, easing: "cubic-bezier(0.16, 1, 0.3, 1)" });
        } else if (!on) panel.hidden = true;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
    const current = () => tabs.find((t) => t.getAttribute("aria-selected") === "true") ?? tabs[0];
    place(current());
    // Fonts can swap after first layout; keep the thumb under its tab.
    document.fonts?.ready.then(() => place(current()));
    new ResizeObserver(() => place(current())).observe(list);
  }
</script>

<style>
  .panels > .panel {
    grid-area: 1 / 1;
  }
  /* Highlights: struck words in the app's red, the result in its green. */
  .mark {
    border-radius: 4px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }
  .mark-rec {
    background-image: linear-gradient(color-mix(in srgb, var(--rec) 20%, transparent), color-mix(in srgb, var(--rec) 20%, transparent));
  }
  .mark-add {
    background-image: linear-gradient(color-mix(in srgb, var(--add) 20%, transparent), color-mix(in srgb, var(--add) 20%, transparent));
  }
  @media (prefers-reduced-motion: no-preference) {
    .thumb {
      transition:
        transform 0.55s var(--ease-omil),
        width 0.55s var(--ease-omil);
    }
    /* On arrival the highlights paint across the removed words in reading order. */
    :global(.js) [data-reveal]:not(.is-in) .mark {
      background-size: 0% 100%;
    }
    :global(.js) .mark {
      transition: background-size 0.6s var(--ease-omil);
      transition-delay: calc(500ms + var(--n) * 140ms);
    }
  }
</style>
