---
import { Icon } from "astro-icon/components";
import { attaches, CLEAN_TEXT, diffTokens, RAW_TEXT } from "../data/site";

// The same sentence, as the app's Changes view shows it (TranscriptDiff + GitDiffView): the
// diff is built at compile time with the app's tokenizer and shown on a pane of glass.
const tokens = diffTokens(RAW_TEXT, CLEAN_TEXT);
type Run = { text: string; marked: boolean };
/** Joins tokens into runs of marked and unmarked text. Spaces stay outside the highlight. */
const runs = (list: typeof tokens, mark: "added" | "removed"): Run[] => {
  const out: Run[] = [];
  list.forEach((t, i) => {
    const space = i > 0 && !attaches(t.text) ? " " : "";
    const marked = t.kind === mark;
    const last = out[out.length - 1];
    if (last && last.marked === marked) {
      last.text += space + t.text;
      return;
    }
    if (space) {
      if (last && !last.marked) last.text += space;
      else out.push({ text: space, marked: false });
    }
    out.push({ text: t.text, marked });
  });
  return out;
};
const original = runs(tokens.filter((t) => t.kind !== "added"), "removed");
const cleaned = runs(tokens.filter((t) => t.kind !== "removed"), "added");
/** Marked runs are numbered so their highlights can paint in reading order. */
const numbered = (list: Run[]) => {
  let n = 0;
  return list.map((r) => ({ ...r, n: r.marked ? n++ : -1 }));
};
const modes = [
  { title: "Clean", body: "Drops the filler, follows your corrections and fixes grammar. The default." },
  { title: "Verbatim", body: "Keeps every word, for quotes, names and code. Switch any time." },
];
---

<section id="cleanup" class="section">
  <div class="shell">
    <h2 data-reveal class="title max-w-[13ch]">It writes what you meant.</h2>
    <p data-reveal style="--i: 1" class="lead mt-6 max-w-[42ch]">
      Say it the way it comes out. Omil keeps the sentence you were reaching for, and its Changes view shows exactly what it did.
    </p>

    <div data-reveal="scale" style="--i: 2" class="pool mt-12 md:mt-16">
      <div class="glass">
        <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-3.5 md:px-8 md:py-4">
          <span class="text-[15px] font-semibold tracking-[-0.015em]">Last transcript</span>
          <span class="rounded-full bg-ink/[0.06] px-3 py-1 text-[13px] font-medium">Changes</span>
        </div>
        <div class="diff px-5 py-6 font-mono md:px-8 md:py-9">
          <p class="flex gap-[1.2em]">
            <span class="text-rec select-none" aria-hidden="true">-</span>
            <span>
              <span class="sr-only">Original: </span>
              {numbered(original).map((r) => (r.marked ? <span class="mark mark-rec" style={`--n: ${r.n}`}>{r.text}</span> : <span>{r.text}</span>))}
            </span>
          </p>
          <p class="mt-[0.9em] flex gap-[1.2em]">
            <span class="text-add select-none" aria-hidden="true">+</span>
            <span>
              <span class="sr-only">Cleaned: </span>
              {numbered(cleaned).map((r) => (r.marked ? <span class="mark mark-add" style={`--n: ${r.n}`}>{r.text}</span> : <span>{r.text}</span>))}
            </span>
          </p>
        </div>
        <div class="flex items-center gap-2 border-t border-line px-5 py-3.5 text-[13.5px] text-muted md:px-8">
          <Icon name="ph:check-circle-fill" class="size-4 text-add" aria-hidden="true" />
          Inserted into focused field
        </div>
      </div>
    </div>

    <dl data-reveal class="mt-12 grid max-w-[46rem] gap-x-14 gap-y-8 sm:grid-cols-2 md:mt-16">
      {
        modes.map((m) => (
          <div>
            <dt class="text-[1.0625rem] font-semibold tracking-[-0.015em]">{m.title}</dt>
            <dd class="mt-1.5 leading-relaxed text-muted">{m.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .diff {
    font-size: clamp(0.875rem, 0.64rem + 0.95vw, 1.3125rem);
    line-height: 1.7;
    letter-spacing: -0.01em;
  }
  /* Highlights: removed words in the app's red, added ones in its green. */
  .mark {
    border-radius: 0.25em;
    padding: 0.1em 0;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }
  .mark-rec {
    background-image: linear-gradient(color-mix(in srgb, var(--rec) 20%, transparent), color-mix(in srgb, var(--rec) 20%, transparent));
  }
  .mark-add {
    background-image: linear-gradient(color-mix(in srgb, var(--add) 20%, transparent), color-mix(in srgb, var(--add) 20%, transparent));
  }
  @media (prefers-reduced-motion: no-preference) {
    /* On arrival the highlights paint across the removed words in reading order. */
    :global(.js) [data-reveal]:not(.is-in) .mark {
      background-size: 0% 100%;
    }
    :global(.js) .mark {
      transition: background-size 0.6s var(--ease-omil);
      transition-delay: calc(500ms + var(--n) * 140ms);
    }
  }
</style>
