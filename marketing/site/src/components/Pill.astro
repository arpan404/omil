---
import { Icon } from "astro-icon/components";

// Omil's floating pill (FlowPill in the Mac app), drawn in HTML so it stays sharp and can
// move through its real states: Start, the live level between cancel and done, Cleaning up, Done.
// Scripts change the state by setting data-state on the root.
interface Props {
  state?: "idle" | "listening" | "cleaning" | "done";
  size?: "md" | "lg";
  class?: string;
  id?: string;
}
const { state = "listening", size = "md", class: className, id } = Astro.props;
// Each bar has its own height, tempo and offset so the level never looks like a loop.
const bars = [0.5, 0.75, 0.95, 0.6, 1, 0.8, 0.55, 0.9, 0.65, 0.85, 0.5, 0.7, 0.45];
---

<div id={id} data-pill data-state={state} class:list={["pill", size === "lg" ? "pill--lg" : "pill--md", className]} aria-hidden="true">
  <div class="pill-body">
    <span class="pill-layer pill-idle">
      <Icon name="ph:microphone-fill" class="size-[1.05em]" />
      Start
    </span>
    <span class="pill-layer pill-listening">
      <span class="pill-round pill-x"><Icon name="ph:x-bold" class="size-[1em]" /></span>
      <span class="pill-bars">
        {bars.map((h, i) => <span class="pill-bar" style={`--h:${h}; --t:${620 + ((i * 137) % 420)}ms; --d:-${(i * 233) % 900}ms`} />)}
      </span>
      <span class="pill-round pill-ok"><Icon name="ph:check-bold" class="size-[1em]" /></span>
    </span>
    <span class="pill-layer pill-cleaning">
      <Icon name="ph:spinner-bold" class="pill-spin size-[1.1em]" />
      Cleaning up
    </span>
    <span class="pill-layer pill-done">
      <Icon name="ph:check-bold" class="size-[1em]" />
      Done
    </span>
  </div>
</div>

<style>
  /* The slot keeps the largest state's size, so a state change never moves the layout. */
  .pill {
    display: inline-grid;
    place-items: center;
    width: calc(142px * var(--s));
    height: calc(36px * var(--s));
    flex: none;
  }
  .pill--md {
    --s: 1.2;
  }
  .pill--lg {
    --s: 1.6;
  }
  .pill-body {
    position: relative;
    width: calc(var(--w) * var(--s));
    height: calc(var(--h) * var(--s));
    border-radius: 999px;
    background: var(--pill);
    color: white;
    backdrop-filter: blur(20px) saturate(1.4);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    box-shadow:
      inset 0 0 0 0.5px rgb(255 255 255 / 0.16),
      0 1px 1px rgb(0 0 0 / 0.16),
      0 14px 30px -10px rgb(0 0 0 / 0.45);
    transition:
      width 0.5s var(--ease-omil),
      height 0.5s var(--ease-omil);
    overflow: hidden;
  }
  [data-state="idle"] .pill-body {
    --w: 78px;
    --h: 28px;
  }
  [data-state="listening"] .pill-body {
    --w: 138px;
    --h: 36px;
  }
  [data-state="cleaning"] .pill-body,
  [data-state="done"] .pill-body {
    --w: 142px;
    --h: 32px;
  }

  /* Every state is drawn in place and centred; only the current one is visible. */
  .pill-layer {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(6px * var(--s));
    font-size: calc(12px * var(--s));
    font-weight: 500;
    letter-spacing: -0.005em;
    white-space: nowrap;
    opacity: 0;
    scale: 0.9;
    transition:
      opacity 0.25s var(--ease-omil),
      scale 0.5s var(--ease-omil);
  }
  [data-state="idle"] .pill-idle,
  [data-state="listening"] .pill-listening,
  [data-state="cleaning"] .pill-cleaning,
  [data-state="done"] .pill-done {
    opacity: 1;
    scale: 1;
    transition-delay: 0.12s;
  }

  .pill-round {
    display: grid;
    place-items: center;
    border-radius: 999px;
    flex: none;
  }
  .pill-x {
    width: calc(24px * var(--s));
    height: calc(24px * var(--s));
    font-size: calc(10px * var(--s));
    background: rgb(255 255 255 / 0.12);
    color: rgb(255 255 255 / 0.8);
  }
  .pill-ok {
    width: calc(28px * var(--s));
    height: calc(28px * var(--s));
    font-size: calc(12px * var(--s));
    background: white;
    color: black;
  }
  .pill-bars {
    display: flex;
    align-items: center;
    gap: calc(2px * var(--s));
    width: calc(54px * var(--s));
    height: calc(24px * var(--s));
  }
  .pill-bar {
    flex: 1;
    height: calc(100% * var(--h));
    border-radius: 99px;
    background: rgb(255 255 255 / 0.96);
    scale: 1 0.16;
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-state="listening"] .pill-bar {
      animation: pill-level var(--t) var(--d) ease-in-out infinite alternate;
    }
    .pill :global(.pill-spin) {
      animation: pill-spin 0.8s steps(8) infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-state="listening"] .pill-bar {
      scale: 1 1;
    }
    .pill-body,
    .pill-layer {
      transition: none;
    }
  }
  @keyframes pill-level {
    from {
      scale: 1 0.16;
    }
    to {
      scale: 1 1;
    }
  }
  @keyframes pill-spin {
    to {
      rotate: 360deg;
    }
  }
</style>
