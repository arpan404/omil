---
// iPhone and iPad are not released yet, so the section says so. The devices stand on the page
// at two depths and travel at different speeds while it scrolls.
---

<section id="iphone" class="section">
  <div class="shell grid items-center gap-x-10 gap-y-6 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" data-devices>
    <div>
      <p data-reveal class="text-[15px] font-medium text-muted">Coming soon</p>
      <h2 data-reveal style="--i: 1" class="title mt-4 max-w-[11ch]">On iPhone and iPad, too.</h2>
      <p data-reveal style="--i: 2" class="lead mt-6 max-w-[34ch]">
        Pair once, then tap the mic on the Omil keyboard in any app. Your Mac does the transcribing, so it stays free and private.
      </p>
    </div>
    <div data-reveal="fade" style="--i: 1" class="devices relative mx-auto aspect-[10/9] w-full max-w-[36rem] lg:mx-0 lg:max-w-none">
      <img
        src="/media/ipad.webp"
        alt="The Omil keyboard on iPad, listening while writing an email in Mail"
        width="2366"
        height="1786"
        loading="lazy"
        decoding="async"
        class="ipad absolute max-w-none"
        data-depth="back"
      />
      <img
        src="/media/iphone-done.webp"
        alt="The Omil keyboard on iPhone after inserting a dictated message in Messages"
        width="1160"
        height="2070"
        loading="lazy"
        decoding="async"
        class="iphone absolute max-w-none"
        data-depth="front"
      />
    </div>
  </div>
</section>

<script>
  import { animate, scroll } from "motion";
  import { reduceMotion } from "../scripts/motion";

  // Depth: the iPad drifts a little, the iPhone in front of it drifts more.
  const root = document.querySelector<HTMLElement>("[data-devices]");
  if (root && !reduceMotion()) {
    const back = root.querySelector<HTMLElement>('[data-depth="back"]')!;
    const front = root.querySelector<HTMLElement>('[data-depth="front"]')!;
    const range = { target: root, offset: ["start end", "end start"] } as const;
    scroll(animate(back, { y: [18, -18] }, { ease: "linear" }), range);
    scroll(animate(front, { y: [48, -48] }, { ease: "linear" }), range);
  }
</script>

<style>
  /* The renders carry their own soft shadows in a transparent margin, so sizes here are
     the image box, not the device. */
  .ipad {
    width: 88%;
    top: 2%;
    right: -2%;
  }
  .iphone {
    width: 34%;
    bottom: 1%;
    left: 1%;
  }
  @media (min-width: 1024px) {
    .ipad {
      width: 94%;
      top: 6%;
      right: -4%;
    }
    .iphone {
      width: 36%;
      bottom: 0;
      left: -2%;
    }
  }
</style>
