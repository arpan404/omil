---
import { Icon } from "astro-icon/components";
import { GITHUB_URL } from "../data/site";

// Where your voice goes: four steps, all on the Mac. A signal travels the path while the
// section is on screen.
const steps = [
  { icon: "ph:microphone", title: "Microphone", body: "Recorded while you hold the key." },
  { icon: "ph:waveform", title: "Speech recognition", body: "Runs on Apple silicon." },
  { icon: "ph:magic-wand", title: "Cleanup", body: "Rewritten on your Mac." },
  { icon: "ph:cursor-text", title: "Your text field", body: "Typed where you were." },
];
---

<section id="private" class="section">
  <div class="shell">
    <div class="mx-auto max-w-[54rem] text-center">
      <h2 data-reveal class="display text-[2.6rem] sm:text-6xl lg:text-[5rem]">Your voice never leaves your Mac.</h2>
      <p data-reveal style="--i: 1" class="lead mx-auto mt-7 max-w-[46ch] md:mt-9">
        No account, no cloud, no subscription. Recognition and cleanup run on the machine in front of you, and{" "}
        <a href={GITHUB_URL} class="text-ink underline decoration-line-strong underline-offset-4 transition-colors duration-300 hover:decoration-ink">the source is public</a>.
      </p>
    </div>

    <div data-reveal="scale" style="--i: 2" class="pool mx-auto mt-14 max-w-[64rem] md:mt-20">
      <div class="glass relative px-6 pt-11 pb-8 md:px-12 md:pt-14 md:pb-11">
        <span class="glass absolute -top-3.5 left-6 inline-flex h-7 items-center gap-1.5 rounded-full px-3 text-[12.5px] font-medium md:left-12">
          <Icon name="ph:laptop" class="size-4" aria-hidden="true" />
          On your Mac
        </span>
        <ol class="flow relative grid gap-y-7 sm:grid-cols-4 sm:gap-x-6" data-flow>
          <span class="rail" aria-hidden="true"><span class="signal"></span></span>
          {
            steps.map((s, i) => (
              <li class="relative flex items-center gap-4 sm:block" style={`--n: ${i}`}>
                <span class="node relative grid size-12 flex-none place-items-center rounded-full text-ink">
                  <Icon name={s.icon} class="size-5" aria-hidden="true" />
                </span>
                <span class="block sm:mt-5">
                  <span class="block font-semibold tracking-[-0.015em]">{s.title}</span>
                  <span class="mt-0.5 block text-[14.5px] leading-relaxed text-muted sm:mt-1">{s.body}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
    <p data-reveal class="mx-auto mt-8 max-w-[64rem] text-center text-[14.5px] text-muted md:mt-10">The internet is used for the first setup and for updates. Nothing you say is sent anywhere.</p>
  </div>
</section>

<script>
  import { whileVisible } from "../scripts/motion";
  const flow = document.querySelector<HTMLElement>("[data-flow]");
  if (flow) whileVisible(flow);
</script>

<style>
  .node {
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line-strong);
  }
  /* The path between the steps, drawn through the centres of the nodes. */
  .rail {
    position: absolute;
    background: var(--line-strong);
    overflow: hidden;
    /* phones: a vertical line */
    left: calc(1.5rem - 0.5px);
    top: 1.5rem;
    bottom: 1.5rem;
    width: 1px;
  }
  .signal {
    display: none;
  }
  @media (min-width: 640px) {
    .rail {
      container-type: inline-size;
      top: calc(1.5rem - 0.5px);
      bottom: auto;
      left: 1.5rem;
      /* four equal columns with 1.5rem gaps: stop at the last node's centre */
      right: calc((100% - 4.5rem) / 4 - 1.5rem);
      width: auto;
      height: 1px;
    }
    .signal {
      display: block;
      width: 7rem;
      height: 100%;
      background: linear-gradient(90deg, transparent, var(--ink) 70%, transparent);
      transform: translateX(-7rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* One pass takes 2.4s (0.8s per step), then rests. Each node lights as the signal reaches it. */
    [data-live] .signal {
      animation: travel 3.6s linear infinite;
    }
    [data-live] .node {
      animation: reach 3.6s var(--ease-omil) infinite;
      animation-delay: calc(var(--n) * 0.8s);
    }
  }
  @keyframes travel {
    0% {
      transform: translateX(-7rem);
    }
    66.6%,
    100% {
      transform: translateX(100cqw);
    }
  }
  @keyframes reach {
    0%,
    26%,
    100% {
      box-shadow: 0 0 0 1px var(--line-strong);
    }
    5% {
      box-shadow:
        0 0 0 1.5px var(--ink),
        0 0 0 6px color-mix(in srgb, var(--ink) 8%, transparent);
    }
  }
</style>
