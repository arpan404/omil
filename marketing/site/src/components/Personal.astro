---
import { Icon } from "astro-icon/components";

// The app's own sample snippets and corrections (the same data its windows show in ../video),
// set as type: what you say, and what Omil writes.
const snippets = [
  { say: "sign off", types: "Thanks! Talk soon, Arpan" },
  { say: "my address", types: "221B Baker Street, London NW1 6XE" },
  { say: "calendar", types: "cal.com/arpan/30min" },
];
const corrections = [
  { heard: "our pan", fixed: "Arpan" },
  { heard: "cube and eighties", fixed: "Kubernetes" },
  { heard: "post grass", fixed: "PostgreSQL" },
];
const more = [
  { title: "History", body: "Your last 200 dictations, searchable and replayable." },
  { title: "No waiting", body: "Start the next recording while the last one is still cleaning up." },
  { title: "Your prompt", body: "The cleanup instructions are plain text you can edit." },
];
---

<section id="personal" class="section">
  <div class="shell">
    <h2 data-reveal class="title max-w-[12ch]">Make it sound like you.</h2>
    <p data-reveal style="--i: 1" class="lead mt-6 max-w-[38ch]">Teach it your phrases and your names once. All of it stays on your Mac.</p>

    <div class="pool mt-12 grid gap-4 md:mt-16 md:gap-5 lg:grid-cols-2">
      <!-- Snippets: a spoken phrase, and the text it stands for. -->
      <article data-reveal class="feature glass p-7 md:p-10">
        <h3 class="text-[1.375rem] font-semibold tracking-[-0.025em]">Snippets</h3>
        <p class="mt-1.5 max-w-[34ch] leading-relaxed text-muted">Say a short phrase and the whole text is typed.</p>
        <ul class="examples mt-9 grid gap-6">
          {
            snippets.map((s, i) => (
              <li class="example" style={`--n: ${i}`}>
                <p class="text-muted">“{s.say}”</p>
                <p class="result mt-1 flex items-baseline gap-[0.45em] font-medium">
                  <Icon name="ph:arrow-bend-down-right" class="size-[0.8em] flex-none translate-y-[0.08em] text-faint" aria-hidden="true" />
                  <span class="sr-only">types </span>
                  {s.types}
                </p>
              </li>
            ))
          }
        </ul>
      </article>

      <!-- Dictionary: what was heard, struck, and what it should have been. -->
      <article data-reveal style="--i: 1" class="feature glass p-7 md:p-10">
        <h3 class="text-[1.375rem] font-semibold tracking-[-0.025em]">Dictionary</h3>
        <p class="mt-1.5 max-w-[34ch] leading-relaxed text-muted">Teach it the names and terms it mishears, once.</p>
        <ul class="examples mt-9 grid gap-6">
          {
            corrections.map((c, i) => (
              <li class="example" style={`--n: ${i}`}>
                <p><s class="heard relative text-muted no-underline">{c.heard}</s></p>
                <p class="result mt-1 flex items-baseline gap-[0.45em] font-medium">
                  <Icon name="ph:arrow-bend-down-right" class="size-[0.8em] flex-none translate-y-[0.08em] text-faint" aria-hidden="true" />
                  <span class="sr-only">becomes </span>
                  {c.fixed}
                </p>
              </li>
            ))
          }
        </ul>
      </article>
    </div>

    <dl data-reveal-stagger class="mt-12 grid gap-x-12 gap-y-9 sm:grid-cols-3 md:mt-16 md:px-10">
      {
        more.map((m) => (
          <div>
            <dt class="text-[1.0625rem] font-semibold tracking-[-0.015em]">{m.title}</dt>
            <dd class="mt-1.5 max-w-[30ch] leading-relaxed text-muted">{m.body}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .examples {
    font-size: clamp(1.1875rem, 1rem + 0.7vw, 1.5625rem);
    line-height: 1.25;
    letter-spacing: -0.028em;
  }
  /* The misheard phrase is struck in the app's red, as cleanup strikes filler. */
  .heard::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 55%;
    height: 0.07em;
    border-radius: 2px;
    background: var(--rec);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* On arrival each example plays once: said or struck first, then what Omil writes. */
    .heard::after {
      transition: transform 0.6s var(--ease-omil);
      transition-delay: calc(500ms + var(--n) * 180ms);
    }
    .result {
      transition:
        opacity 0.7s var(--ease-omil),
        translate 0.7s var(--ease-omil);
      transition-delay: calc(750ms + var(--n) * 180ms);
    }
    :global(.js) .feature:not(.is-in) .heard::after {
      transform: scaleX(0);
    }
    :global(.js) .feature:not(.is-in) .result {
      opacity: 0;
      translate: -0.3em 0;
    }
  }
</style>
