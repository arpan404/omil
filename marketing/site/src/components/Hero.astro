---
import { Icon } from "astro-icon/components";
import { GITHUB_URL } from "../data/site";
import DownloadButton from "./DownloadButton.astro";
import Pill from "./Pill.astro";

// The hero is the product working. On the left the headline arrives as spoken and cleans
// itself (filler struck, then a FLIP as the words settle). On the right a dictation plays in a
// window: words are heard, cleaned, and typed where the cursor is. It loops through a few apps
// until the reader takes over with the key under it, or the real Right Option key.
type Word = { t: string; drop?: boolean; clean?: string };
const scenes: { app: string; icon: string; label: string; value: string; pre: string; words: Word[]; clean: string }[] = [
  {
    app: "Mail",
    icon: "ph:envelope-simple",
    label: "To:",
    value: "Maya Chen",
    pre: "Hi Maya,",
    words: [
      { t: "Um,", drop: true },
      { t: "so", drop: true },
      { t: "I" },
      { t: "think" },
      { t: "we" },
      { t: "should,", clean: "should" },
      { t: "uh,", drop: true },
      { t: "ship" },
      { t: "it" },
      { t: "on" },
      { t: "Friday.", drop: true },
      { t: "No", drop: true },
      { t: "wait,", drop: true },
      { t: "Thursday." },
    ],
    clean: "I think we should ship it on Thursday.",
  },
  {
    app: "Notes",
    icon: "ph:note-pencil",
    label: "In:",
    value: "Monday standup",
    pre: "Today",
    words: [
      { t: "Uh,", drop: true },
      { t: "finish", clean: "Finish" },
      { t: "the" },
      { t: "release" },
      { t: "notes," },
      { t: "and" },
      { t: "then,", clean: "then" },
      { t: "um,", drop: true },
      { t: "review" },
      { t: "Leo's" },
      { t: "pull" },
      { t: "request." },
    ],
    clean: "Finish the release notes, and then review Leo's pull request.",
  },
  {
    app: "Messages",
    icon: "ph:chat-circle",
    label: "To:",
    value: "Leo Park",
    pre: "Leo: Are you still coming to the 10:30?",
    words: [
      { t: "Uh,", drop: true },
      { t: "running", clean: "Running" },
      { t: "like,", drop: true },
      { t: "ten" },
      { t: "minutes" },
      { t: "late." },
      { t: "Start" },
      { t: "without" },
      { t: "me." },
    ],
    clean: "Running ten minutes late. Start without me.",
  },
];
const steps = [
  { id: "hold", title: "Hold Right Option", body: "In any app, wherever your cursor is." },
  { id: "speak", title: "Say what you mean", body: "Pause, restart, change your mind halfway." },
  { id: "release", title: "Let go", body: "The clean version is typed where you were." },
];
---

<section class="hero relative" data-demo data-phase="idle" data-scenes={JSON.stringify(scenes)}>
  <div class="shell pt-28 md:pt-36 lg:pt-40">
    <div id="how">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,11fr)_minmax(0,13fr)] lg:gap-16">
      <div>
        <h1 class="display headline text-[2.85rem] sm:text-6xl lg:text-[4.125rem] xl:text-[4.75rem]" aria-label="You think faster than you type." data-headline>
          <span aria-hidden="true" class="words">
            <span class="w filler" style="--i: 0">Um,</span>
            <span class="w" style="--i: 1"><span class="case"><span class="lo">y</span><span class="up">Y</span></span>ou</span>
            <span class="w" style="--i: 2">think</span>
            <span class="w" style="--i: 3">faster</span>
            <span class="w" style="--i: 4">than</span>
            <span class="w" style="--i: 5">you<span class="filler">,</span></span>
            <span class="w filler" style="--i: 6">uh,</span>
            <span class="w" style="--i: 7">type.</span>
          </span>
        </h1>

        <p class="lead rise mt-6 max-w-[34ch] md:mt-7" style="--i: 9" data-follows>
          Omil is free dictation for your Mac. Hold Right Option, talk, let go. Clean text lands wherever you were typing.
        </p>

        <div class="rise mt-8 flex flex-wrap items-center gap-x-2 gap-y-3 md:mt-9" style="--i: 11" data-follows>
          <DownloadButton />
          <a href={GITHUB_URL} class="btn btn-quiet">
            <Icon name="ph:github-logo" class="size-[18px] text-muted" aria-hidden="true" />
            View source
          </a>
        </div>
      </div>

      <!-- The stage: some app with a text field, what is being heard, and the pill. -->
      <div class="stage desk grain relative isolate flex min-h-[25rem] flex-col items-center overflow-hidden sm:min-h-[29rem] lg:min-h-[31rem]" aria-hidden="true">
        <div class="app card relative my-auto w-full max-w-[32rem] rounded-2xl text-left" data-app>
          <div class="flex h-10 items-center gap-3.5 border-b border-line px-4">
            <span class="lights flex gap-[7px]"><i></i><i></i><i></i></span>
            <span class="grid text-[13px] font-medium tracking-[-0.005em]">
              {
                scenes.map((s, i) => (
                  <span class:list={["scene-title flex items-center gap-1.5", i === 0 && "is-on"]} data-scene-title>
                    <Icon name={s.icon} class="size-4 text-muted" />
                    {s.app}
                  </span>
                ))
              }
            </span>
          </div>
          <div class="px-4 pt-3 pb-4 sm:px-5 sm:pb-5" data-app-content>
            <p class="flex items-center gap-2 text-[13.5px]">
              <span class="text-faint" data-app-label>{scenes[0].label}</span>
              <span class="rounded-full bg-tile px-2.5 py-0.5 font-medium" data-app-value>{scenes[0].value}</span>
            </p>
            <p class="mt-3.5 text-[16px] leading-[1.45] tracking-[-0.01em] text-muted sm:text-[17px]" data-app-pre>{scenes[0].pre}</p>
            <p class="field-line mt-1.5 text-[16px] leading-[1.45] tracking-[-0.01em] sm:text-[17px]" data-line><span data-landed></span><span class="caret"></span></p>
          </div>
        </div>

        <div class="heard-slot">
          <div class="heard" data-heard>
            <p class="transcript flex flex-wrap content-center justify-center gap-x-[0.28em] text-center text-[1.0625rem] leading-[1.3] font-medium tracking-[-0.018em] sm:text-[1.25rem]" data-transcript></p>
          </div>
        </div>

        <Pill id="demo-pill" state="idle" size="lg" />
      </div>
    </div>

    <!-- The key that drives the stage, and the three steps, which light up as it plays. -->
    <div class="mt-8 grid gap-x-10 gap-y-8 lg:mt-12 lg:grid-cols-[auto_minmax(0,1fr)] lg:items-center">
      <div class="rise flex items-center gap-4" style="--i: 14">
        <button type="button" class="keycap relative flex-none touch-none select-none" data-key aria-label="Hold to dictate a sample sentence">
          <span class="keycap-top">
            <Icon name="ph:option" class="size-[22px] self-end" aria-hidden="true" />
            <span class="mt-auto self-end text-[10.5px] font-medium tracking-wide text-muted">option</span>
          </span>
        </button>
        <div class="min-w-0 lg:w-[14rem]">
          <p class="text-[15px] font-medium tracking-[-0.01em]" aria-live="polite"><span data-hint>Hold to try it</span><span class="sr-only" data-result></span></p>
          <p class="mt-0.5 text-[13.5px] leading-snug text-muted">Or use your real Right Option key.</p>
        </div>
      </div>
      <ol class="rise grid gap-x-8 gap-y-1.5 sm:grid-cols-3" style="--i: 16" aria-label="How a dictation works">
        {
          steps.map((s) => (
            <li class="step relative py-3 pl-5 sm:pt-5 sm:pb-0 sm:pl-0" data-step={s.id}>
              <span class="step-rail" aria-hidden="true" />
              <span class="step-t block font-semibold tracking-[-0.018em]">{s.title}</span>
              <span class="mt-1 block text-[14.5px] leading-relaxed text-muted">{s.body}</span>
            </li>
          ))
        }
      </ol>
    </div>
    </div>
  </div>
</section>

<script>
  import { EASE, fadeOut, flip, reduceMotion, riseIn, wait } from "../scripts/motion";

  // ------------------------------------------------------------ the headline cleans itself

  const h = document.querySelector<HTMLElement>("[data-headline]");
  if (h) {
    const words = [...h.querySelectorAll<HTMLElement>(".w")];
    const fillers = [...h.querySelectorAll<HTMLElement>(".filler")];
    // The headline loses a line, so what follows it glides up with the words.
    const follows = [...document.querySelectorAll<HTMLElement>("[data-follows]")];
    const clean = async () => {
      h.classList.add("is-struck");
      await wait(reduceMotion() ? 0 : 750);
      await Promise.all(fillers.map((f) => fadeOut(f, 360)));
      await flip([...words, ...follows], () => h.classList.add("is-clean"), 800);
    };
    if (reduceMotion()) clean();
    else setTimeout(clean, 1700);
  }

  // ------------------------------------------------------------ the stage

  type Word = { t: string; drop?: boolean; clean?: string };
  type Scene = { label: string; value: string; pre: string; words: Word[]; clean: string };

  const root = document.querySelector<HTMLElement>("[data-demo]");
  if (root) {
    const scenes: Scene[] = JSON.parse(root.dataset.scenes!);
    const stage = root.querySelector<HTMLElement>(".stage")!;
    const pill = root.querySelector<HTMLElement>("#demo-pill")!;
    const key = root.querySelector<HTMLButtonElement>("[data-key]")!;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const result = root.querySelector<HTMLElement>("[data-result]")!;
    const transcript = root.querySelector<HTMLElement>("[data-transcript]")!;
    const content = root.querySelector<HTMLElement>("[data-app-content]")!;
    const titles = [...root.querySelectorAll<HTMLElement>("[data-scene-title]")];
    const label = root.querySelector<HTMLElement>("[data-app-label]")!;
    const value = root.querySelector<HTMLElement>("[data-app-value]")!;
    const pre = root.querySelector<HTMLElement>("[data-app-pre]")!;
    const line = root.querySelector<HTMLElement>("[data-line]")!;
    const landed = root.querySelector<HTMLElement>("[data-landed]")!;
    const steps = [...root.querySelectorAll<HTMLElement>("[data-step]")];

    type Phase = "idle" | "listening" | "cleaning" | "done";
    let phase: Phase = "idle";
    let scene = 0;
    let run = 0; // increments on every press so a stale run stops itself
    let held = false;
    let auto = false; // the page is holding the key, not the reader
    let touched = false;
    let looping = false;
    let visible = false;
    let spoken = 0;

    const setPhase = (p: Phase, text?: string) => {
      phase = p;
      root.dataset.phase = p;
      pill.dataset.state = p;
      const active = p === "idle" ? -1 : p === "listening" ? 1 : 2;
      steps.forEach((s, i) => s.classList.toggle("is-lit", i <= active));
      hint.textContent = text ?? (p === "idle" ? "Hold to try it" : p === "listening" ? "Listening. Let go to finish." : p === "cleaning" ? "Cleaning up" : "Typed into the field");
      // Screen readers also hear what was typed.
      result.textContent = p === "done" ? `: ${scenes[scene].clean}` : "";
    };

    /** The window becomes the next app. */
    const show = async (next: number) => {
      scene = next;
      const s = scenes[scene];
      const swap = () => {
        titles.forEach((t, i) => t.classList.toggle("is-on", i === scene));
        label.textContent = s.label;
        value.textContent = s.value;
        pre.textContent = s.pre;
        landed.textContent = "";
      };
      if (reduceMotion()) return swap();
      await content.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 220, easing: "ease-out", fill: "forwards" }).finished;
      swap();
      content.getAnimations().forEach((a) => a.cancel());
      content.animate([{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 500, easing: EASE });
    };

    /** Clears the last dictation. A finished one makes way for the next app. */
    const reset = async () => {
      transcript.getAnimations().forEach((a) => a.cancel());
      transcript.classList.remove("is-struck");
      transcript.replaceChildren();
      line.getAnimations().forEach((a) => a.cancel());
      if (landed.textContent) await show((scene + 1) % scenes.length);
    };

    const addWord = (w: Word) => {
      const el = document.createElement("span");
      el.className = "tw" + (w.drop ? " tw-drop" : "");
      el.textContent = w.t;
      if (w.clean) el.dataset.clean = w.clean;
      transcript.append(el);
      riseIn(el, 520);
    };

    const press = async () => {
      if (held) return;
      held = true;
      const id = ++run;
      key.classList.add("is-down");
      await reset();
      if (id !== run) return;
      setPhase("listening");
      spoken = 0;
      const words = scenes[scene].words;
      // Words arrive at a speaking pace while the key is held.
      while (held && spoken < words.length && id === run) {
        addWord(words[spoken++]);
        await wait(290);
      }
    };

    const release = async () => {
      if (!held) return;
      held = false;
      auto = false;
      key.classList.remove("is-down");
      const id = run;
      const { words: all, clean } = scenes[scene];
      // Whatever was not yet said arrives quickly, then the cleanup happens.
      await wait(60);
      while (spoken < all.length && id === run) {
        addWord(all[spoken++]);
        await wait(45);
      }
      if (id !== run) return;
      setPhase("cleaning");
      await wait(reduceMotion() ? 0 : 520);
      if (id !== run) return;

      const words = [...transcript.querySelectorAll<HTMLElement>(".tw")];
      const drops = words.filter((w) => w.classList.contains("tw-drop"));
      const kept = words.filter((w) => !w.classList.contains("tw-drop"));
      transcript.classList.add("is-struck");
      await wait(reduceMotion() ? 0 : 620);
      if (id !== run) return;
      await Promise.all(drops.map((d) => fadeOut(d, 320)));
      if (id !== run) return;
      await flip(
        words,
        () => {
          drops.forEach((d) => (d.style.display = "none"));
          words.forEach((w) => w.dataset.clean && (w.textContent = w.dataset.clean));
        },
        650,
      );
      if (id !== run) return;
      await wait(reduceMotion() ? 0 : 260);
      if (id !== run) return;

      // The clean sentence leaves the transcript and lands in the field, shrinking to its size.
      const from = kept[0].getBoundingClientRect();
      const ratio = parseFloat(getComputedStyle(transcript).fontSize) / parseFloat(getComputedStyle(line).fontSize);
      landed.textContent = clean;
      if (!reduceMotion()) {
        const to = line.getBoundingClientRect();
        line.animate(
          [
            { transform: `translate(${from.left - to.left}px, ${from.top - to.top}px) scale(${ratio})`, opacity: 0.4 },
            { transform: "none", opacity: 1 },
          ],
          { duration: 850, easing: EASE, fill: "both" },
        );
        transcript.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 160, fill: "forwards", easing: "ease-out" }).finished.then(() => {
          if (id !== run) return;
          transcript.replaceChildren();
          transcript.getAnimations().forEach((a) => a.cancel());
        });
      } else {
        transcript.replaceChildren();
      }
      setPhase("done");
      await wait(2800);
      if (id !== run || phase !== "done") return;
      setPhase("idle", touched ? "Hold again for the next one" : undefined);
    };

    const take = () => {
      touched = true;
      auto = false;
    };

    // Pointer: mouse and touch, with capture so a drag off the key still releases.
    key.addEventListener("pointerdown", (e) => {
      if (e.button !== 0 && e.pointerType === "mouse") return;
      key.setPointerCapture(e.pointerId);
      take();
      press();
    });
    for (const ev of ["pointerup", "pointercancel", "lostpointercapture"] as const) key.addEventListener(ev, () => !auto && release());
    key.addEventListener("contextmenu", (e) => e.preventDefault());

    // Keyboard on the key itself: Space or Enter held down.
    key.addEventListener("keydown", (e) => {
      if (e.key !== " " && e.key !== "Enter") return;
      e.preventDefault();
      take();
      if (!e.repeat) press();
    });
    key.addEventListener("keyup", (e) => {
      if (e.key === " " || e.key === "Enter") release();
    });

    // The real Right Option key, while the stage is on screen.
    document.addEventListener("keydown", (e) => {
      if (visible && e.code === "AltRight" && !e.repeat) {
        e.preventDefault();
        take();
        press();
      }
    });
    document.addEventListener("keyup", (e) => {
      if (e.code === "AltRight") release();
    });
    window.addEventListener("blur", () => !auto && release());

    setPhase("idle");

    // Until the reader takes over, the page holds the key itself, one app after another,
    // and rests while the stage is off screen.
    const loop = async () => {
      if (looping) return;
      looping = true;
      while (visible && !touched && !document.hidden) {
        auto = true;
        await press();
        if (!auto) break;
        await wait(450);
        if (!auto) break;
        await release();
        if (touched) break;
        await wait(900);
      }
      looping = false;
    };
    if (reduceMotion()) {
      // No performance: the finished state, and the key still works.
      landed.textContent = scenes[0].clean;
      setPhase("done");
    } else {
      new IntersectionObserver(
        ([e]) => {
          visible = e.isIntersecting;
          if (visible) loop();
        },
        { threshold: 0.35 },
      ).observe(stage);
      document.addEventListener("visibilitychange", () => !document.hidden && visible && loop());
    }
  }
</script>

<style>
  /* A faint light from above, so the page has a top. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 44rem;
    z-index: -1;
    background: radial-gradient(70% 60% at 30% 0%, color-mix(in srgb, var(--ink) 5%, transparent), transparent 70%);
    pointer-events: none;
  }

  /* ---------------------------------------------------------------- headline */

  /* Clean, it sets as two lines: "You think faster / than you type." */
  .headline {
    max-width: 8.4em;
  }
  /* Words are flex items: the gap between them stays explicit, and a hidden filler word
     takes its gap with it. */
  .words {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.23em;
  }
  .w {
    display: inline-block;
    position: relative;
  }
  .filler {
    color: var(--faint);
  }
  /* The strike draws first, in the app's red. */
  .filler::after {
    content: "";
    position: absolute;
    left: -0.02em;
    right: -0.02em;
    top: 56%;
    height: 0.05em;
    border-radius: 99px;
    background: var(--rec);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.55s var(--ease-omil);
  }
  /* The stray comma just fades with the rest. */
  .w .filler::after {
    display: none;
  }
  .is-struck .filler::after {
    transform: scaleX(1);
  }
  .is-struck .w:nth-child(7)::after {
    transition-delay: 0.12s;
  }
  .is-clean .filler {
    display: none;
  }
  .case {
    display: inline-grid;
  }
  .case > span {
    grid-area: 1 / 1;
    transition: opacity 0.3s var(--ease-omil);
  }
  .up {
    opacity: 0;
  }
  .is-clean .lo {
    opacity: 0;
  }
  .is-clean .up {
    opacity: 1;
  }

  /* ---------------------------------------------------------------- stage */

  .stage {
    --pad: 1rem;
    padding: var(--pad);
    padding-bottom: calc(var(--pad) + 0.375rem);
  }
  .stage :global(.pill--lg) {
    --s: 1.2;
  }
  @media (min-width: 640px) {
    .stage {
      --pad: 1.75rem;
    }
    .stage :global(.pill--lg) {
      --s: 1.5;
    }
  }
  @media (min-width: 1024px) {
    .stage {
      --pad: 2.25rem;
    }
  }
  /* Window lights, in the page's own greys. */
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--ink) 14%, transparent);
  }
  .scene-title {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.4s var(--ease-omil);
  }
  .scene-title.is-on {
    opacity: 1;
  }
  .field-line {
    transform-origin: 0 0;
    min-height: 2.9em;
  }

  /* What is being heard: a pane of glass above the pill. Its slot keeps two lines of height,
     so neither the words arriving nor the cleanup move the window above it. */
  .heard-slot {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    min-height: calc(2 * 1.3 * 1.0625rem + 1.75rem);
    margin: 1.25rem 0 1rem;
  }
  .heard {
    display: grid;
    width: max-content;
    max-width: 100%;
    min-height: calc(2 * 1.3 * 1.0625rem + 1.75rem);
    padding: 0.875rem 1.25rem;
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--surface) 62%, transparent);
    backdrop-filter: blur(18px) saturate(1.5);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    box-shadow:
      0 0 0 1px var(--line),
      inset 0 1px 0 var(--highlight),
      0 12px 28px -16px rgb(var(--shadow-tint) / 0.25);
    transform-origin: 50% 100%;
    transition:
      opacity 0.35s var(--ease-omil),
      scale 0.5s var(--ease-omil);
  }
  @media (min-width: 640px) {
    .heard-slot,
    .heard {
      min-height: calc(2 * 1.3 * 1.25rem + 1.75rem);
    }
    .heard {
      max-width: 29rem;
    }
  }
  .heard:has(.transcript:empty) {
    opacity: 0;
    scale: 0.96;
  }
  @media (prefers-reduced-transparency: reduce) {
    .heard {
      background: var(--surface);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  /* Transcript words. Dropped words are struck in red before they leave. */
  .transcript :global(.tw) {
    display: inline-block;
    position: relative;
  }
  .transcript :global(.tw-drop) {
    transition: color 0.4s var(--ease-omil);
  }
  .transcript.is-struck :global(.tw-drop) {
    color: var(--faint);
  }
  .transcript :global(.tw-drop)::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 54%;
    height: 2px;
    border-radius: 99px;
    background: var(--rec);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-omil);
  }
  .transcript.is-struck :global(.tw-drop)::after {
    transform: scaleX(1);
  }

  /* ---------------------------------------------------------------- key and steps */

  /* Steps: a rail that fills as the dictation moves on. On a phone it runs down the side. */
  .step-rail {
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 2px;
    border-radius: 2px;
    background: var(--line-strong);
    overflow: hidden;
  }
  .step-rail::after {
    content: "";
    position: absolute;
    inset: 0;
