---
import DownloadButton from "./DownloadButton.astro";

// The opening line of the story, dictated in front of the reader. The key at the bottom of the
// screen goes down and the pill listens while the headline arrives word by word, as spoken.
// The key comes up, the pill cleans up, the filler is struck and drops out, and the remaining
// words slide into place (a FLIP over transforms only).
//
// The HTML holds only the finished sentence, so search engines, link previews and readers
// without JavaScript get "You think faster than you type." The script adds the filler words
// for the performance and takes them out again when it ends.
---

<section class="hero relative">
  <div class="shell inner flex min-h-[100svh] flex-col items-center justify-center pt-24 pb-36 text-center md:pb-40" data-hero>
    <h1 class="display headline text-[2.85rem] sm:text-6xl md:text-7xl lg:text-[5.75rem] xl:text-[6.25rem]" data-headline data-script>
      <span class="words">
        {/* The spaces are real text, so the sentence reads correctly without styles. The flex layout ignores them. */}
        <span class="w">You</span>{" "}
        <span class="w">think</span>{" "}
        <span class="w">faster</span>{" "}
        <span class="w">than</span>{" "}
        <span class="w">you</span>{" "}
        <span class="w">type.</span>
      </span>
    </h1>

    <p class="lead rise mt-8 max-w-[40ch] md:mt-10" style="--i: 0" data-follows>
      Omil is free dictation for your Mac. Hold a key, talk, and clean text lands wherever you were typing.
    </p>

    <div class="rise mt-9 md:mt-10" style="--i: 1" data-follows>
      <DownloadButton size="lg" />
    </div>
  </div>
</section>

<script>
  import { animate, scroll } from "motion";
  import { dockPill, setDock, type PillState } from "../scripts/dock";
  import { fadeOut, flip, reduceMotion, wait } from "../scripts/motion";

  const h = document.querySelector<HTMLElement>("[data-headline]");
  if (h) {
    h.dataset.script = "ready";
    const line = h.querySelector<HTMLElement>(".words")!;
    const clean = [...line.querySelectorAll<HTMLElement>(".w")];
    const sentence = line.innerHTML;
    let words = clean;
    let fillers: HTMLElement[] = [];

    /** The sentence as it is spoken: "Um, you think faster than you, uh, type." */
    const speak = () => {
      const el = (className: string, text: string) => Object.assign(document.createElement("span"), { className, textContent: text });
      const [first, , , , you, last] = clean;
      const y = el("case", "");
      y.append(el("lo", "y"), el("up", "Y"));
      first.replaceChildren(y, "ou");
      const comma = el("filler", ",");
      you.append(comma);
      const um = el("w filler", "Um,");
      const uh = el("w filler", "uh,");
      first.before(um);
      last.before(uh);
      fillers = [um, comma, uh];
      words = [...line.querySelectorAll<HTMLElement>(":scope > .w")];
      // Screen readers hear the sentence once, not the performance.
      h.setAttribute("aria-label", "You think faster than you type.");
    };
    // If the headline loses a line, what follows it glides with the words.
    const follows = [...document.querySelectorAll<HTMLElement>("[data-follows]")];
    // The dock is the hero's only until the reader scrolls into the story.
    const story = document.querySelector<HTMLElement>("[data-story]");
    const mine = () => !story || story.dataset.state === "0";
    const dock = (down: boolean, pill: PillState) => mine() && setDock(down, pill);

    const dictate = async () => {
      // Key down: Omil listens, and the headline is said.
      await wait(700);
      dock(true, "listening");
      await wait(260);
      for (const w of words) {
        w.classList.add("is-said");
        await wait(165);
      }
      // Key up: the filler is struck, leaves, and the sentence closes up.
      await wait(450);
      dock(false, "cleaning");
      h.classList.add("is-struck");
      await wait(850);
      await Promise.all(fillers.map((f) => fadeOut(f, 360)));
      await flip([...words, ...follows], () => h.classList.add("is-clean"), 850);
      dock(false, "done");
      // Back to the plain sentence, which is what the page's HTML has said all along.
      line.innerHTML = sentence;
      line.querySelectorAll(".w").forEach((w) => w.classList.add("is-said"));
      h.removeAttribute("aria-label");
      await wait(2600);
      if (dockPill() === "done") dock(false, "idle");
    };

    if (!reduceMotion()) {
      speak();
      dictate();
    }
  }

  // Leaving: the opening recedes as the story scrolls in.
  const inner = document.querySelector<HTMLElement>("[data-hero]");
  if (inner && !reduceMotion()) {
    scroll(animate(inner, { opacity: [1, 1, 0], y: [0, -20, -90] }, { times: [0, 0.3, 0.9], ease: "linear" }), {
      target: inner,
      offset: ["start start", "end start"],
    });
  }
</script>

<style>
  /* A faint light from above, so the page has a top. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 46rem;
    z-index: -1;
    background: radial-gradient(60% 55% at 50% 0%, color-mix(in srgb, var(--ink) 5%, transparent), transparent 70%);
    pointer-events: none;
  }

  /* Clean, it sets as two lines: "You think faster than / you type." */
  .headline {
    max-width: 10em;
  }
  /* Words are flex items: the gap between them stays explicit, and a hidden filler word
     takes its gap with it. */
  .words {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.23em;
  }
  .words :global(.w) {
    display: inline-block;
    position: relative;
  }
  /* The filler words are added by the script, so these rules reach them through :global. */
  .words :global(.filler) {
    color: var(--faint);
  }
  /* The strike draws first, in the app's red. */
  .words :global(.filler)::after {
    content: "";
    position: absolute;
    left: -0.02em;
    right: -0.02em;
    top: 56%;
    height: 0.05em;
    border-radius: 99px;
    background: var(--rec);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.55s var(--ease-omil);
  }
  /* The stray comma just fades with the rest. */
  .words :global(.w .filler)::after {
    display: none;
  }
  .is-struck .words :global(.filler)::after {
    transform: scaleX(1);
  }
  .is-struck .words :global(.w:nth-child(7))::after {
    transition-delay: 0.12s;
  }
  .is-clean .words :global(.filler) {
    display: none;
  }
  .words :global(.case) {
    display: inline-grid;
  }
  .words :global(.case > span) {
    grid-area: 1 / 1;
    transition: opacity 0.3s var(--ease-omil);
  }
  .words :global(.up) {
    opacity: 0;
  }
  .is-clean .words :global(.lo) {
    opacity: 0;
  }
  .is-clean .words :global(.up) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Each word waits to be said. */
    :global(.js) .words :global(.w) {
      opacity: 0;
      translate: 0 0.28em;
      transition:
        opacity 0.5s var(--ease-omil),
        translate 0.7s var(--ease-omil);
    }
    :global(.js) .words :global(.w.is-said) {
      opacity: 1;
      translate: 0 0;
    }
    /* The copy and the button are there from the start. */
    :global(.js) .rise {
      animation: rise 1.1s var(--ease-omil) both;
      animation-delay: calc(350ms + var(--i, 0) * 110ms);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
