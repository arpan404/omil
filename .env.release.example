# GitHub token with permission to create releases in arpan404/omil.
GH_TOKEN=

# Developer ID Application identity installed in the login keychain.
DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (TEAMID)"

# Developer team used for code signing.
APPLE_TEAM_ID=

# App Store Connect team API key for notarization and iOS provisioning.
# Download the .p8 once from Users and Access > Integrations > Team Keys.
# Use an absolute path or a path relative to the repository root.
APPLE_API_KEY_PATH=
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=

# Local iOS export for manual upload using Transporter or Xcode Organizer.
IOS_EXPORT_METHOD=app-store-connect
# Use release-testing only for an ad hoc IPA on registered test devices.

# Optional GitHub target; must match SUFeedURL in the Mac app.
GH_REPO=arpan404/omil

# Exported by Sparkle's generate_keys tool. Keep the private key secret.
SPARKLE_PRIVATE_KEY=
SPARKLE_PUBLIC_KEY=
