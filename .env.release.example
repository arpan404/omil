# GitHub token with permission to create releases in arpan404/omil.
GH_TOKEN=

# Developer ID Application identity installed in the login keychain.
DEVELOPER_ID_APPLICATION="Developer ID Application: Your Name (TEAMID)"

# Apple notarization credentials.
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_SPECIFIC_PASSWORD=

# Exported by Sparkle's generate_keys tool. Keep the private key secret.
SPARKLE_PRIVATE_KEY=
SPARKLE_PUBLIC_KEY=
